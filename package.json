{
  "name": "backend",
  "private": true,
  "version": "0.0.0",
  "description": "AI CV Builder — NestJS API and BullMQ worker",
  "files": [
    "dist",
    "drizzle",
    "assets"
  ],
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "dev": "API_DOCS=true LOG_LEVEL=debug LOG_CONTENT=true LOG_PRETTY=true nest start --watch --exec \"node --env-file-if-exists=../.env\"",
    "dev:worker": "LOG_LEVEL=debug LOG_CONTENT=true LOG_PRETTY=true nest start --watch --entryFile worker --exec \"node --env-file-if-exists=../.env\"",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.mts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.72",
    "@cv/shared": "workspace:*",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "ai": "^7.0.128",
    "argon2": "^0.45.1",
    "bullmq": "^5.81.5",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.3",
    "ioredis": "^5.11.1",
    "nestjs-pino": "^5.3.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.1.0",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.13",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "oxlint": "^1.86.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.9",
    "supertest": "^7.3.1",
    "typescript": "~6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24"
  }
}
